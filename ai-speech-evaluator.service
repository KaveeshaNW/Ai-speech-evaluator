[Unit]
Description=AI Speech Evaluator - Toastmasters Embedded Assistant
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=astro
Group=astro
WorkingDirectory=/home/astro/Ai-speech evaluator/Ai-speech-evaluator
ExecStart=/bin/bash "/home/astro/Ai-speech evaluator/Ai-speech-evaluator/run_app.sh"
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SupplementaryGroups=i2c gpio audio

[Install]
WantedBy=multi-user.target
