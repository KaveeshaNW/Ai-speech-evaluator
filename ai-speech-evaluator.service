[Unit]
Description=AI Speech Evaluator - Toastmasters Embedded Assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ai-speech-evaluator
EnvironmentFile=/home/pi/ai-speech-evaluator/.env
ExecStart=/home/pi/ai-speech-evaluator/venv/bin/python3 main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security and hardware isolation
SupplementaryGroups=i2c gpio audio

[Install]
WantedBy=multi-user.target
