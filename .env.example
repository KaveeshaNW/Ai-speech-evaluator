# ==============================================================================
# AI Speech Evaluator - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials & pin configurations.
# ==============================================================================

# ------------------------------------------------------------------------------
# Cloud APIs
# ------------------------------------------------------------------------------
# Deepgram Speech-to-Text API Key (obtain from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LanguageTool API (Free tier: https://api.languagetoolplus.com/v2/check or Premium)
# If using free tier without an account, leave API_KEY blank.
LANGUAGETOOL_API_KEY=
LANGUAGETOOL_USERNAME=
LANGUAGETOOL_API_URL=https://api.languagetoolplus.com/v2/check
LANGUAGETOOL_LANGUAGE=en-US

# ------------------------------------------------------------------------------
# Hardware - LCM1602A 16x2 LCD Display (PCF8574 I2C Backpack)
# ------------------------------------------------------------------------------
# Default address is usually 0x27 or 0x3F. Run 'i2cdetect -y 1' on Raspberry Pi.
LCD_I2C_ADDRESS=0x27
LCD_I2C_PORT=1
LCD_COLS=16
LCD_ROWS=2

# ------------------------------------------------------------------------------
# Hardware - Control Toggle Switch
# ------------------------------------------------------------------------------
# Connected between GPIO 18 (BCM) and GND using internal pull-up resistor (GPIO.PUD_UP).
# Switch ON  = GPIO.LOW (closed circuit to GND)
# Switch OFF = GPIO.HIGH (open circuit, pulled high)
SWITCH_GPIO_PIN=18
SWITCH_BOUNCE_TIME_MS=250

# ------------------------------------------------------------------------------
# Hardware - USB Microphone (M-305 via USB Audio Adapter)
# ------------------------------------------------------------------------------
# PyAudio input device index. Set to -1 to auto-detect USB Audio or use default.
AUDIO_DEVICE_INDEX=-1
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# ------------------------------------------------------------------------------
# System & Reporting
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
REPORT_OUTPUT_DIR=reports
# When running on non-RPi platforms or without connected hardware, set to true
SIMULATE_HARDWARE=false
